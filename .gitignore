
# ==============================
# LabGear - Git Ignore
# ==============================

# Python virtual environments
.venv/
venv/

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# React / Node.js
node_modules/
dist/
coverage/

# Environment variables and secrets
.env
.env.*
!.env.example

# Private configuration files
config.local.json
secrets.json
*.pem
*.key

# Logs
*.log
logs/

# Local databases and backups
*.sqlite3
*.db
*.sql.gz

# Operating system files
.DS_Store
Thumbs.db
